d>\r\n            <td class=\"yes-no-col\">No</td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">b.</td>\r\n            <td class=\"item-col\">Is that type of component manufactured previously \t</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">c.</td>\r\n            <td class=\"item-col\">Is additional Shift/Overtime requires for production of that component\t</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n         <!--3) number start-->\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">3)</td>\r\n            <td class=\"item-col\">Production Requirements</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n         <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">a. </td>\r\n            <td class=\"item-col\">Can we manufacture the component in available resources\t</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">b.</td>\r\n            <td class=\"item-col\">Any process capability required by customer</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">c.</td>\r\n            <td class=\"item-col\">Is additional Shift/Overtime requires for production of that component\t</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\">No</td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">d.</td>\r\n            <td class=\"item-col\">Can we achieve production targets that our customer satisfies always with us</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">e.</td>\r\n            <td class=\"item-col\">Packing Required by customer</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n         <!--4) number start-->\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">4)</td>\r\n            <td class=\"item-col\">IMTE Requirements</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">a.</td>\r\n            <td class=\"item-col\">Is there any new additional IMTE requires\t</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\">No</td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">b.</td>\r\n            <td class=\"item-col\">Laboratory testing required by customer for R.M</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\">No</td>\r\n            <td class=\"comment-col\">RMTC </td>\r\n        </tr>\r\n         <!--5) number start-->\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">5)</td>\r\n            <td class=\"item-col\">Other Requirements </td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">a.</td>\r\n            <td class=\"item-col\">Any Statutory Regulatory, Government  Requirement</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\">ROHS </td>\r\n        </tr>\r\n         <!--6) number start-->\r\n          <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">6)</td>\r\n            <td class=\"item-col\">Development Stage\t</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n         <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">a. </td>\r\n            <td class=\"item-col\">Development Period given by customer </td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\">No</td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">b.</td>\r\n            <td class=\"item-col\">Sample Submission/Pilot Lot Required</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">c.</td>\r\n            <td class=\"item-col\">P.O Received (P.O No. & Date)</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\">4500131888\t</td>\r\n        </tr>\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">d.</td>\r\n            <td class=\"item-col\">Review of P.O Dobe\t</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n         <!--7) number start-->\r\n        <tr class=\"checklist-row\">\r\n            <td class=\"sr-no-col\">7)</td>\r\n            <td class=\"item-col\">Final Decision of feasibility & Development</td>\r\n            <td class=\"yes-no-col\">Yes</td>\r\n            <td class=\"yes-no-col\"></td>\r\n            <td class=\"comment-col\"></td>\r\n        </tr>\r\n        \r\n        \r\n        <tr><td colspan=\"5\" style=\"padding: 0 !important;\">\r\n            <div class=\"rows \">\r\n                <div class=\"cols-2 borders-end p-2\"><b>PREPARED BY -</b></div>\r\n                <div class=\"cols-4 borders-end p-2\">--</div>\r\n                <div class=\"cols-2 borders-end p-2\"><b>APPROVED BY-</b></div>\r\n                <div class=\"cols-4 p-2\">--</div>\r\n            </div>\r\n        </td></tr>\r\n        \r\n        <tr>\r\n        <td colspan=\"1\" class=\"text-center\" style=\"padding: 0 !important;\">\r\n          <div class=\"p-2\"><b>R.No.</b></div>\r\n        </td>\r\n        <td colspan=\"4\" style=\"padding: 0 !important;\">\r\n          <div class=\"rows text-center\">\r\n            <div class=\"cols-3 borders-end p-2\"><b>Date of Change</b></div>\r\n            <div class=\"cols-4 borders-end p-2\"><b>Detail of Change</b></div>\r\n            <div class=\"cols-2 borders-end p-2\"><b>Revised By</b></div>\r\n            <div class=\"cols-3 p-2\"><b>Approved By</b></div>\r\n          </div>\r\n        </td>\r\n      </tr>\r\n      \r\n      {% if doc.revisions %}\r\n        {% for row in doc.revisions %}\r\n        <tr>\r\n          <td colspan=\"1\" class=\"text-center\" style=\"padding: 0 !important;\">\r\n            <div class=\"p-2\">{{ row.revision_no or loop.index }}</div>\r\n          </td>\r\n          <td colspan=\"4\" style=\"padding: 0 !important;\">\r\n            <div class=\"rows text-center\">\r\n              <div class=\"cols-3 borders-end p-2\">\r\n                {{ frappe.format_date(row.date_of_change, \"dd-MM-yyyy\") if row.date_of_change else '' }}\r\n              </div>\r\n              <div class=\"cols-4 borders-end p-2\">{{ row.detail_of_change or '' }}</div>\r\n              <div class=\"cols-2 borders-end p-2\">{{ row.revised_by or '' }}</div>\r\n              <div class=\"cols-3 p-2\">{{ row.approved_by or '' }}</div>\r\n            </div>\r\n          </td>\r\n        </tr>\r\n        {% endfor %}\r\n      {% else %}\r\n        <!-- If no revisions found, show 3 empty rows -->\r\n        {% for i in range(3) %}\r\n        <tr>\r\n          <td colspan=\"1\" class=\"text-center\" style=\"padding: 0 !important;\"><div class=\"p-2\"></div></td>\r\n          <td colspan=\"4\" style=\"padding: 0 !important;\">\r\n            <div class=\"rows text-center\">\r\n              <div class=\"cols-3 borders-end p-2\"></div>\r\n              <div class=\"cols-4 borders-end p-2\"></div>\r\n              <div class=\"cols-2 borders-end p-2\"></div>\r\n              <div class=\"cols-3 p-2\"></div>\r\n            </div>\r\n          </td>\r\n        </tr>\r\n        {% endfor %}\r\n      {% endif %}\r\n\r\n        <!--<tr>-->\r\n        <!--    <td colspan=\"1\" class=\"text-center\"style=\"padding: 0 !important;\" ><div class=\"p-2\"><b>R.No.</b></div></td>-->\r\n        <!--    <td colspan=\"4\" style=\"padding: 0 !important;\">-->\r\n        <!--        <div class=\"rows text-center\">-->\r\n        <!--            <div class=\"cols-3 borders-end p-2\"><b>Date of Change</b></div>-->\r\n        <!--            <div class=\"cols-4 borders-end p-2\"><b>Detail of Change\t</b></div>-->\r\n        <!--            <div class=\"cols-2 borders-end p-2\"><b>Revised  By</b></div>-->\r\n        <!--            <div class=\"cols-3 p-2\"><b>Approved By</b></div>-->\r\n        <!--        </div>-->\r\n        <!--    </td>-->\r\n        <!--</tr>-->\r\n        <!--<tr>-->\r\n        <!--    <td colspan=\"1\" class=\"text-center\"style=\"padding: 0 !important;\" ><div class=\"p-2\"><b></b></div></td>-->\r\n        <!--    <td colspan=\"4\" style=\"padding: 0 !important;\">-->\r\n        <!--        <div class=\"rows text-center\">-->\r\n        <!--            <div class=\"cols-3 borders-end p-2\"><b></b></div>-->\r\n        <!--            <div class=\"cols-4 borders-end p-2\"><b>\t</b></div>-->\r\n        <!--            <div class=\"cols-2 borders-end p-2\"><b></b></div>-->\r\n        <!--            <div class=\"cols-3 p-2\"><b></b></div>-->\r\n        <!--        </div>-->\r\n        <!--    </td>-->\r\n        <!--</tr>-->\r\n        <!--<tr>-->\r\n        <!--    <td colspan=\"1\" class=\"text-center\"style=\"padding: 0 !important;\" ><div class=\"p-2\"><b></b></div></td>-->\r\n        <!--    <td colspan=\"4\" style=\"padding: 0 !important;\">-->\r\n        <!--        <div class=\"rows text-center\">-->\r\n        <!--            <div class=\"cols-3 borders-end p-2\"><b></b></div>-->\r\n        <!--            <div class=\"cols-4 borders-end p-2\"><b></b></div>-->\r\n        <!--            <div class=\"cols-2 borders-end p-2\"><b></b></div>-->\r\n        <!--            <div class=\"cols-3 p-2\"><b></b></div>-->\r\n        <!--        </div>-->\r\n        <!--    </td>-->\r\n        <!--</tr>-->\r\n        \r\n    </table>\r\n\r\n\r\n",
